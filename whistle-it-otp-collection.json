{
	"info": {
		"_postman_id": "whistle-it-otp-auth",
		"name": "🎵 Whistle IT - OTP Authentication",
		"description": "Complete OTP Authentication System for Whistle IT - Registration, Login, and Forgot Password flows with email verification",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "whistle-it-otp"
	},
	"item": [
		{
			"name": "🔐 OTP Registration Flow",
			"item": [
				{
					"name": "1️⃣ Send Registration OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store email for next requests",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        pm.collectionVariables.set('testEmail', JSON.parse(pm.request.body.raw).email);",
									"        pm.collectionVariables.set('otpExpires', response.expires_at);",
									"        console.log('✅ OTP sent for:', pm.collectionVariables.get('testEmail'));",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test.user.{{random}}@example.com\",\n    \"type\": \"registration\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/send-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"send-otp"
							]
						},
						"description": "Send a 6-digit OTP to the user's email for registration verification"
					},
					"response": []
				},
				{
					"name": "2️⃣ Verify Registration OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store token if verification successful",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.token) {",
									"        pm.collectionVariables.set('authToken', response.data.token);",
									"        console.log('✅ OTP verified, token stored');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"otp\": \"123456\",\n    \"type\": \"registration\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Verify the 6-digit OTP received in email. Replace '123456' with the actual OTP from your email."
					},
					"response": []
				},
				{
					"name": "3️⃣ Complete Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Update token if registration completed",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.token) {",
									"        pm.collectionVariables.set('authToken', response.data.token);",
									"        pm.collectionVariables.set('userName', response.data.user.name);",
									"        console.log('✅ Registration completed for:', response.data.user.name);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"name\": \"Test User {{random}}\",\n    \"password\": \"Password123!\",\n    \"password_confirmation\": \"Password123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/complete-registration",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"complete-registration"
							]
						},
						"description": "Complete registration by providing name and password. Must be called after OTP verification."
					},
					"response": []
				},
				{
					"name": "4️⃣ Login (After OTP Verification)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store login token",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status && response.data.token) {",
									"        pm.collectionVariables.set('authToken', response.data.token);",
									"        console.log('✅ Login successful, token updated');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"Password123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login with credentials after OTP verification. Should work only if email is verified."
					},
					"response": []
				}
			],
			"description": "Complete registration flow with OTP verification"
		},
		{
			"name": "🔒 Forgot Password Flow",
			"item": [
				{
					"name": "1️⃣ Send Forgot Password OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store email for password reset",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        pm.collectionVariables.set('resetEmail', JSON.parse(pm.request.body.raw).email);",
									"        console.log('✅ Password reset OTP sent for:', pm.collectionVariables.get('resetEmail'));",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"type\": \"forgot_password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"forgot-password"
							]
						},
						"description": "Send OTP for password reset to existing user's email"
					},
					"response": []
				},
				{
					"name": "2️⃣ Reset Password with OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Clear auth token after password reset",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        pm.collectionVariables.unset('authToken');",
									"        console.log('✅ Password reset successful, token cleared');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{resetEmail}}\",\n    \"otp\": \"654321\",\n    \"password\": \"NewPassword123!\",\n    \"password_confirmation\": \"NewPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"reset-password"
							]
						},
						"description": "Reset password using OTP. Replace '654321' with the actual OTP from your email."
					},
					"response": []
				},
				{
					"name": "3️⃣ Login with New Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store new login token",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.status && response.data.token) {",
									"        pm.collectionVariables.set('authToken', response.data.token);",
									"        console.log('✅ Login with new password successful');",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{resetEmail}}\",\n    \"password\": \"NewPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Test login with the new password after successful reset"
					},
					"response": []
				}
			],
			"description": "Complete forgot password flow with OTP verification"
		},
		{
			"name": "🛡️ Protected API Tests",
			"item": [
				{
					"name": "👤 Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"profile"
							]
						},
						"description": "Test protected endpoint with authentication token"
					},
					"response": []
				},
				{
					"name": "🏢 Get Workspaces",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/workspaces",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"workspaces"
							]
						},
						"description": "Test protected workspace endpoint"
					},
					"response": []
				}
			],
			"description": "Test protected API endpoints with authentication"
		},
		{
			"name": "⚠️ Error Scenarios",
			"item": [
				{
					"name": "❌ Invalid OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"otp\": \"999999\",\n    \"type\": \"registration\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Test with invalid OTP - should return 400 error"
					},
					"response": []
				},
				{
					"name": "❌ Expired OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"otp\": \"123456\",\n    \"type\": \"registration\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Test with expired OTP - should return 400 error"
					},
					"response": []
				},
				{
					"name": "❌ Duplicate Registration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"type\": \"registration\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/send-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"send-otp"
							]
						},
						"description": "Test duplicate registration - should return 400 error"
					},
					"response": []
				}
			],
			"description": "Test error scenarios and validation"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Generate random number for unique emails",
					"if (!pm.collectionVariables.get('random')) {",
					"    pm.collectionVariables.set('random', Math.floor(Math.random() * 10000));",
					"}",
					"",
					"// Log current state",
					"console.log('🔧 Pre-request:', {",
					"    baseUrl: pm.collectionVariables.get('baseUrl'),",
					"    testEmail: pm.collectionVariables.get('testEmail'),",
					"    hasToken: !!pm.collectionVariables.get('authToken'),",
					"    userName: pm.collectionVariables.get('userName')",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log response",
					"console.log('📊 Response:', {",
					"    status: pm.response.code,", 
					"    success: pm.response.json().success || pm.response.json().status,",
					"    message: pm.response.json().message || pm.response.json().data?.message",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "testEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "resetEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userName",
			"value": "",
			"type": "string"
		},
		{
			"key": "random",
			"value": "",
			"type": "string"
		}
	]
}
