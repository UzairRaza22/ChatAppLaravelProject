{
	"info": {
		"_postman_id": "whistle-it-api-collection",
		"name": "Whistle IT API",
		"description": "Complete API collection for Whistle IT application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/api/health"
			}
		},
		{
			"name": "Public Users",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/api/users"
			}
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test User\", \"email\": \"test@example.com\", \"password\": \"password123\"}"
						},
						"url": "{{baseUrl}}/api/auth/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"email\": \"test@example.com\", \"password\": \"password123\"}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/auth/logout"
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/auth/profile"
					}
				},
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"email\": \"test@example.com\", \"type\": \"registration\"}"
						},
						"url": "{{baseUrl}}/api/auth/send-otp"
					}
				}
			]
		},
		{
			"name": "Workspaces",
			"item": [
				{
					"name": "List Workspaces",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/workspaces"
					}
				},
				{
					"name": "Create Workspace",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test Workspace\", \"description\": \"A test workspace\"}"
						},
						"url": "{{baseUrl}}/api/workspaces"
					}
				}
			]
		},
		{
			"name": "Teams",
			"item": [
				{
					"name": "List Teams",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/teams"
					}
				},
				{
					"name": "Create Team",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test Team\", \"workspace_id\": \"123456\", \"description\": \"A test team\"}"
						},
						"url": "{{baseUrl}}/api/teams"
					}
				}
			]
		},
		{
			"name": "Channels",
			"item": [
				{
					"name": "List Channels",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/channels"
					}
				},
				{
					"name": "Create Channel",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test Channel\", \"workspace_id\": \"123456\", \"team_id\": \"123456\", \"type\": \"public\"}"
						},
						"url": "{{baseUrl}}/api/channels"
					}
				}
			]
		},
		{
			"name": "Messages",
			"item": [
				{
					"name": "List Messages",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/messages?channel_id=123456"
					}
				},
				{
					"name": "Create Message",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"channel_id\": \"123456\", \"content\": \"Test message\", \"message_type\": \"text\"}"
						},
						"url": "{{baseUrl}}/api/messages"
					}
				}
			]
		},
		{
			"name": "Files",
			"item": [
				{
					"name": "List Files",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{authToken}}"}
						],
						"url": "{{baseUrl}}/api/files"
					}
				},
				{
					"name": "Upload File",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{authToken}}"}],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "file", "type": "file", "src": "/path/to/test.txt"},
								{"key": "channel_id", "value": "123456", "type": "text"}
							]
						},
						"url": "{{baseUrl}}/api/files"
					}
				}
			]
		}
	]
}
