# Laravel Docker Environment Configuration
APP_NAME="Whistle-It"
APP_ENV=local
APP_KEY=base64:ICfCGjqu7SIsx3rJNECI7gUOOILx8FB16cdBapUZFRM=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MongoDB)
DB_CONNECTION=mongodb
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=whistle_it
MONGO_USERNAME=whistle_user
MONGO_PASSWORD=whistle_password
MONGO_AUTH_SOURCE=admin
MONGO_AUTH_DATABASE=admin

# GridFS Configuration
GRIDFS_CONNECTION=mongodb
GRIDFS_DATABASE=whistle_it

# Cache Configuration
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=sync

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration (Mailhog for testing)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@whistle-it.com
MAIL_FROM_NAME="${APP_NAME}"

# Additional Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
